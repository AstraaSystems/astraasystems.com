# Astraa Production Environment Template
#
# TEMPLATE ONLY.
# Do not put real secrets in this file.
# Real production values must come from the secure host environment or secret manager.
#
# Host/TLS deployment requirement:
# - Production public website and API must run over HTTPS/TLS.
# - Flask development server must not be exposed publicly.
# - API should run behind Gunicorn/WSGI or managed production runtime.
# - Reverse proxy or managed platform must terminate TLS.
# - CORS must be locked to approved Astraa HTTPS origins only.

# ==============================================================================
# PUBLIC LAUNCH / AUTH SAFETY FLAGS
# ==============================================================================

ASTRAA_PUBLIC_LAUNCH_MODE=true

# Must remain unset or false on production host.
# Never set this to true in production.
ASTRAA_ALLOW_DEV_LOGIN_PUBLIC_MODE=false

# ==============================================================================
# HOST / HTTPS / TLS
# ==============================================================================

# Final deployed public website origin.
# Example only. Replace with final approved production origin before deployment.
ASTRAA_PUBLIC_SITE_ORIGIN=https://www.astraasystems.com

# Final deployed app/API origin.
# Example only. Replace with final approved production origin before deployment.
ASTRAA_APP_ORIGIN=https://app.astraasystems.com

# HTTPS/TLS is required for production.
ASTRAA_REQUIRE_HTTPS=true
ASTRAA_TLS_REQUIRED=true

# ==============================================================================
# CORS / ALLOWED_ORIGINS
# ==============================================================================

# CORS must not use wildcard origins in production.
# ALLOWED_ORIGINS must include only final approved Astraa HTTPS origins.
ALLOWED_ORIGINS=https://www.astraasystems.com,https://app.astraasystems.com

# Optional app-specific alias if backend uses ASTRAA_ALLOWED_ORIGINS.
ASTRAA_ALLOWED_ORIGINS=https://www.astraasystems.com,https://app.astraasystems.com

# ==============================================================================
# SECRETS — PLACEHOLDERS ONLY
# ==============================================================================

# Do not commit real values.
# Set real values only in secure host environment or secret manager.

SECRET_KEY=<set-in-secret-manager>
ASTRAA_SESSION_SECRET=<set-in-secret-manager>

MONERIS_STORE_ID=<set-in-secret-manager>
MONERIS_API_TOKEN=<set-in-secret-manager>
MONERIS_CHECKOUT_ID=<set-in-secret-manager>

DATABASE_URL=<set-in-secret-manager>

AUTH_PROVIDER_ISSUER=<set-in-secret-manager>
AUTH_PROVIDER_CLIENT_ID=<set-in-secret-manager>
AUTH_PROVIDER_CLIENT_SECRET=<set-in-secret-manager>

# ==============================================================================
# SAFETY NOTES
# ==============================================================================

# No real customer access should be broadly opened by this template.
# Payment auto-unlock must not be treated as production-approved until deployed
# Moneris regression is completed against the final Host/TLS deployment.
