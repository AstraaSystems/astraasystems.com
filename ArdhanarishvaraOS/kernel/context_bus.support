#!/usr/bin/env python3
#===============================================================================
#  ARDHANARISHVARA OS KERNEL MODULE
#  Sovereign Context Bus — Unified Inter-Agent Event Stream
#  File: context_bus.support
#  System: ARKA Pillai Holdings — Sovereign AI Kernel
#===============================================================================
#  DESCRIPTION:
#  This kernel module provides the sovereign-grade, high-resilience,
#  mailbox-driven event bus used by all 7 income engines, Lux Trading AI,
#  ArkaUltimateSupervisor, and the ArkaCognitiveRouter.
#
#  FEATURES:
#    • Local SQLite event ledger (tamper-resistant)
#    • Priority channels (Prestige-tier routing)
#    • Mailbox-style agent targeting
#    • Topic vector routing
#    • Idempotent consumption
#    • Kernel-level publish/consume wrappers
#    • Supervisor-bridge compatibility
#    • Autonomy protocol hooks (future expansion)
#
#  THIS FILE IS SELF-CONTAINED AND DROP-IN READY.
#===============================================================================

import sqlite3
import os
import json
import time
import uuid
from typing import Dict, Any, List, Optional

#===============================================================================
#  KERNEL CLASS: SovereignContextBus
#===============================================================================
class SovereignContextBus:
    """
    The sovereign event bus powering the entire ARKA ecosystem.
    All agents communicate through this bus using mailbox semantics.
    """

    def __init__(self, db_name: str = "sovereign_bus.db"):
        self.db_path = os.path.join(
            os.getenv("SOVEREIGN_DATA_DIR", "./"),
            db_name
        )
        self._bootstrap_bus_schema()

    #---------------------------------------------------------------------------
    #  SCHEMA INITIALIZATION
    #---------------------------------------------------------------------------
    def _bootstrap_bus_schema(self):
        """Initializes the sovereign event ledger with priority routing."""
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS system_event_stream (
                    event_id TEXT PRIMARY KEY,
                    origin_agent TEXT NOT NULL,
                    target_mailbox TEXT NOT NULL,
                    topic_vector TEXT NOT NULL,
                    payload_json TEXT NOT NULL,
                    timestamp_epoch REAL NOT NULL,
                    priority_flag INTEGER DEFAULT 0,
                    read_state INTEGER DEFAULT 0
                )
            """)
            conn.commit()

    #---------------------------------------------------------------------------
    #  PUBLISH EVENT
    #---------------------------------------------------------------------------
    def publish_telemetry_event(
        self,
        origin: str,
        target: str,
        topic: str,
        payload: Dict[str, Any],
        priority: int = 0
    ) -> str:
        """
        Publishes an event into the sovereign bus.
        Priority 1 = Prestige-tier instant routing.
        """
        event_uid = f"EVT-{uuid.uuid4().hex[:8].upper()}"

        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.cursor()
            cursor.execute(
                """
                INSERT INTO system_event_stream
                (event_id, origin_agent, target_mailbox, topic_vector,
                 payload_json, timestamp_epoch, priority_flag, read_state)
                VALUES (?, ?, ?, ?, ?, ?, ?, 0)
                """,
                (
                    event_uid,
                    origin,
                    target,
                    topic,
                    json.dumps(payload),
                    time.time(),
                    priority
                )
            )
            conn.commit()

        return event_uid

    #---------------------------------------------------------------------------
    #  CONSUME EVENTS
    #---------------------------------------------------------------------------
    def consume_mailbox_stream(self, agent_name: str) -> List[Dict[str, Any]]:
        """
        Retrieves unread events for the specified agent.
        Priority events are delivered first.
        """
        with sqlite3.connect(self.db_path) as conn:
            conn.row_factory = sqlite3.Row
            cursor = conn.cursor()

            cursor.execute(
                """
                SELECT * FROM system_event_stream
                WHERE target_mailbox = ?
                AND read_state = 0
                ORDER BY priority_flag DESC, timestamp_epoch ASC
                """,
                (agent_name,)
            )

            rows = cursor.fetchall()
            events = []

            for row in rows:
                events.append({
                    "event_id": row["event_id"],
                    "origin": row["origin_agent"],
                    "topic": row["topic_vector"],
                    "payload": json.loads(row["payload_json"]),
                    "epoch": row["timestamp_epoch"],
                    "priority": row["priority_flag"]
                })

                cursor.execute(
                    "UPDATE system_event_stream SET read_state = 1 WHERE event_id = ?",
                    (row["event_id"],)
                )

            conn.commit()
            return events

    #---------------------------------------------------------------------------
    #  KERNEL HOOK: FLUSH MAILBOX (Optional)
    #---------------------------------------------------------------------------
    def flush_mailbox(self, agent_name: str) -> int:
        """
        Clears all events for an agent. Useful for:
        • nightly autonomy resets
        • tenant decommissioning
        • emergency kernel sweeps
        """
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.cursor()
            cursor.execute(
                "DELETE FROM system_event_stream WHERE target_mailbox = ?",
                (agent_name,)
            )
            deleted = cursor.rowcount
            conn.commit()
            return deleted

#===============================================================================
#  END OF FILE — context_bus.support
#===============================================================================
