#
#    - get_invoice(invoice_id)
#         Retrieves stored invoice.
#
#===============================================================================
#  DATABASE STRUCTURE:
#
#    Table: usage_records
#      record_id        TEXT PRIMARY KEY
#      client           TEXT
#      units            REAL
#      rate             REAL
#      cost             REAL
#      timestamp_epoch  REAL
#
#    Table: invoices
#      invoice_id       TEXT PRIMARY KEY
#      client           TEXT
#      subtotal         REAL
#      tax              REAL
#      total            REAL
#      metadata_json    TEXT
#      timestamp_epoch  REAL
