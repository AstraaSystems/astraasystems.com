#  FUNCTION OVERVIEW:
#
#    - add_node(name, address)
#         Registers network node.
#
#    - add_link(node_a, node_b, cost)
#         Creates network link.
#
#    - register_service(service, node_id)
#         Registers service endpoint.
#
#    - discover(service)
#         Returns nodes offering service.
#
#    - compute_route(start, end)
#         Computes optimal route.
#
#    - snapshot()
#         Returns orchestration state.
#
