#
#    - register_component(name, renderer)
#         Registers a UI component renderer.
#
#    - register_event(event, handler)
#         Registers an event handler.
#
#    - render(component, props)
#         Renders a UI component asynchronously.
#
#    - dispatch_event(event, payload)
#         Dispatches UI events to handlers.
#
#    - set_state(key, value)
#         Updates UI state.
#
#    - snapshot()
#         Returns full UI state snapshot.
